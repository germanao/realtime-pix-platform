#!/bin/bash
set -euo pipefail
dnf install -y docker jq
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins /opt/realtime-pix
curl -fsSL https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
echo '${compose_base64}' | base64 -d >/opt/realtime-pix/docker-compose.yml

cat >/opt/realtime-pix/nginx.conf <<'NGINX'
events {}
http {
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 80;
    if ($http_x_realtime_pix_origin != "${origin_header}") { return 403; }
    proxy_read_timeout 3600s;
    location ~ ^/(sessions|presence)/ {
      proxy_pass http://identity-presence:8080;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
    }
    location ~ ^/events/ {
      proxy_pass http://realtime-events:8080;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
    }
    location = /realtime/token {
      proxy_pass http://realtime-events:8080;
      proxy_set_header Host $host;
    }
    location / {
      proxy_pass http://api-gateway:8080;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
    }
  }
}
NGINX
cat >/usr/local/sbin/realtime-pix-start <<'START'
#!/bin/bash
set -euo pipefail
umask 077
cd /opt/realtime-pix
aws ssm get-parameter --region '${aws_region}' --name '${parameter_path}/aws-only-env' --with-decryption --query Parameter.Value --output text > .env
docker compose up -d --pull missing --remove-orphans
START
chmod +x /usr/local/sbin/realtime-pix-start
cat >/etc/systemd/system/realtime-pix.service <<'UNIT'
[Unit]
Description=Realtime PIX AWS-only demo runtime
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/realtime-pix-start
ExecStop=/usr/bin/docker compose -f /opt/realtime-pix/docker-compose.yml down
TimeoutStartSec=900
Restart=on-failure
RestartSec=15
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable realtime-pix.service
# Existing data must be restored from a verified private S3 backup before a
# replacement host is started. Bootstrap never resets databases implicitly.
systemctl start realtime-pix.service || true
